# Where this build's account features point. None of these is a secret: all
# ship inside the built extension, and firestore.rules is what protects the
# data. A self-hosted copy changes these lines and nothing else.
#
# VITE_FIREBASE_*        the Firebase web app's config (Project settings → Your apps)
# VITE_GOOGLE_CLIENT_ID  the OAuth client of type "Chrome Extension" registered
#                        against this extension's ID
#
# Left empty, the extension builds and works exactly as before, and Settings
# says sign-in is not set up.
VITE_FIREBASE_API_KEY="AIzaSyD29-L--T_2zE_GSThJwQev8k_sm2jX0HQ"
VITE_FIREBASE_AUTH_DOMAIN="upsolve-tracker.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="upsolve-tracker"
VITE_FIREBASE_APP_ID="1:259519365954:web:97a2226e6b57b20bd77edb"
VITE_GOOGLE_CLIENT_ID="259519365954-a7p6gb708tkspjr1eaesaqblnkjikf3j.apps.googleusercontent.com"
