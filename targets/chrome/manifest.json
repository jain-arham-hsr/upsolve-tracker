{
  "manifest_version": 3,
  "name": "Upsolve Tracker",
  "version": "3.0.0",
  "description": "Systematically upsolve Codeforces, AtCoder and CodeChef contests.",
  "key": "",
  "permissions": ["activeTab", "storage", "sidePanel", "identity"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "192": "icons/icon-192.png",
    "512": "icons/icon-512.png"
  },
  "action": {
    "default_title": "Open Upsolve Tracker",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "core/ui/index.html"
  },
  "background": {
    "service_worker": "targets/chrome/background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "core/ui/options/index.html",
    "open_in_tab": true
  }
}
